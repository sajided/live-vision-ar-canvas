# Server-only. Never prefix with VITE_ (that would ship it to the browser).
GEMINI_API_KEY=
# gemma-4-26b-a4b-it (faster MoE) or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
# JSON mime type (no schema; Gemma rejects responseJsonSchema)
GEMMA_JSON_MODE=true
# MINIMAL | LOW | MEDIUM | HIGH
GEMMA_THINKING_LEVEL=MINIMAL
PORT=8787
# Make one tiny model call at boot to warm the connection
GEMMA_WARMUP=true
# full | compact (shorter system prompt, faster prefill)
PROMPT_VARIANT=full
